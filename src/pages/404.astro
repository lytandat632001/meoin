---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Không tìm thấy trang — Mẹo In"
  description="Trang bạn tìm không tồn tại."
>
  <section class="notfound">
    <div class="container">
      <div class="notfound-content">
        <div class="notfound-icon" aria-hidden="true">🐱</div>
        <h1>404</h1>
        <h2>Mèo không tìm thấy trang này</h2>
        <p>Có thể đường dẫn đã bị đổi hoặc trang không tồn tại. Mèo gợi ý bạn quay về trang chủ hoặc xem sản phẩm.</p>
        <div class="notfound-cta">
          <a href="/" class="btn btn-primary btn-lg">Về trang chủ</a>
          <a href="/san-pham" class="btn btn-outline btn-lg">Xem sản phẩm</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding: var(--space-20) 0;
    text-align: center;
  }

  .notfound-content {
    max-width: 560px;
    margin: 0 auto;
  }

  .notfound-icon {
    font-size: 5rem;
    margin-bottom: var(--space-4);
  }

  .notfound h1 {
    font-size: 5rem;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: var(--space-4);
    letter-spacing: -0.05em;
  }

  .notfound h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .notfound p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }

  .notfound-cta {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>