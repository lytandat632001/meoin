---
import { site } from "../config/site";

const telHref = `tel:${site.phone}`;
const zaloHref = `https://zalo.me/${site.zalo}`;
---

<div class="floating-contact">
  <a href={telHref} class="float-btn float-phone" aria-label="Gọi điện">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
      <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.36 11.36 0 003.57.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.57 1 1 0 01-.25 1.02l-2.2 2.2z"/>
    </svg>
  </a>
  <a href={zaloHref} target="_blank" rel="noopener" class="float-btn float-zalo" aria-label="Chat Zalo">
    <span>Zalo</span>
  </a>
</div>

<style>
  .floating-contact {
    position: fixed;
    right: 20px;
    bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 999;
  }

  .float-btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    font-size: 0.75rem;
    transition: all var(--transition-base);
    position: relative;
  }

  .float-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    animation: pulse 2s infinite;
    z-index: -1;
  }

  .float-phone {
    background: var(--color-primary);
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.4);
  }

  .float-phone::before { background: var(--color-primary); }

  .float-zalo {
    background: #0068ff;
    box-shadow: 0 4px 16px rgba(0, 104, 255, 0.4);
  }

  .float-zalo::before { background: #0068ff; }

  .float-btn:hover {
    transform: scale(1.1);
    color: #fff;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(1.4); opacity: 0; }
  }

  @media (max-width: 640px) {
    .floating-contact {
      right: 12px;
      bottom: 16px;
    }
    .float-btn {
      width: 50px;
      height: 50px;
    }
  }
</style>